PROJECT_NAME="IELTS Vision Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

SECRET_KEY="your-super-secret-key-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database URL (PostgreSQL hoặc SQLite fallback)
DATABASE_URL="sqlite:///./ielts_vision_backend.db"
# postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Local Ollama AI Models
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_VISION_MODEL="llava-phi3:latest"
OLLAMA_VOCAB_MODEL="qwen2.5:latest"
OLLAMA_GRADING_MODEL="qwen2.5:7b"
AI_EXPLAIN_TIMEOUT_SECONDS=40
AI_WRITING_TIMEOUT_SECONDS=60

# SMTP Configuration (Email OTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="IELTS Vision"
OTP_EXPIRE_MINUTES=5

BACKEND_CORS_ORIGINS=["*"]
